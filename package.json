{
  "name": "@ossianravn/friction",
  "version": "0.2.0",
  "description": "A local-first feedback loop for coding agents and agent frameworks.",
  "keywords": [
    "codex",
    "claude-code",
    "coding-agents",
    "agent-frameworks",
    "agents-md",
    "agent-skills",
    "developer-tools",
    "local-first"
  ],
  "homepage": "https://github.com/ossianravn/Friction#readme",
  "bugs": {
    "url": "https://github.com/ossianravn/Friction/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ossianravn/Friction.git"
  },
  "license": "MIT",
  "author": "Ossian Ravn <hello@ossianravn.dev>",
  "type": "module",
  "bin": {
    "friction": "dist/bin/friction.js"
  },
  "files": [
    "dist/",
    "assets/",
    "skills/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test test/**/*.test.ts",
    "check:lines": "node scripts/check-code-lines.mjs",
    "check": "npm run check:lines && npm run typecheck && npm test && npm run build",
    "pack:smoke": "node scripts/pack-smoke.mjs",
    "release:check": "npm run check && npm run pack:smoke",
    "prepublishOnly": "npm run release:check"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsx": "^4.23.10",
    "typescript": "^7.0.2"
  }
}
